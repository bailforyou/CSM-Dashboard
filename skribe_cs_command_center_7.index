po":"2026-08-24"}];
const REPS=["Randy Brown","Jake Davis"];
function repSel(owner,onch,wide){return `<select class="rep-sel" style="font-size:12px;${wide?"":"max-width:130px"}" onchange="${onch}"><option value="">— rep —</option>${REPS.map(r=>`<option value="${r}" ${owner===r?"selected":""}>${r}</option>`).join("")}</select>`;}
const OSTATUSES=["Not started","Welcome sent","Walkthrough done","Tech check done","First depo held ✓","At risk / issue","Handed to Sales"];
const STATUSES=["Not started","Outreach sent","Replied","Walkthrough booked","Depo rebooked ✓","No response","Handed to Sales"];
const FLAGMETA={dark:{lbl:"TIER 1 · DARK",cls:"b-dark",pri:0},cancel:{lbl:"HIGH CANCEL",cls:"b-cancel",pri:1},summer:{lbl:"RECENTLY QUIET",cls:"b-summer",pri:2},single:{lbl:"SINGLE-THREADED",cls:"b-single",pri:3}};

// ---------- in-memory state (export/import for WoW) ----------
let state={week:new Date().toISOString().slice(0,10),firms:{},onboard:{}};
let lastWeek=null;
FIRMS.forEach(f=>{state.firms[f.firm]={status:0,owner:"",next:"",notes:""}});
ONBOARD.forEach(f=>{state.onboard[f.firm]={status:0,owner:"",notes:""}});

document.getElementById("weekLbl").textContent="week of "+new Date().toLocaleDateString(undefined,{month:"short",day:"numeric"});

// ---------- KPI tiles ----------
function counts(st){const c={total:0,rebooked:0,touched:0,walk:0};Object.values(st.firms).forEach(v=>{c.total++;if(v.status===4)c.rebooked++;if(v.status>=1&&v.status!==5)c.touched++;if(v.status===3)c.walk++;});return c;}
function renderTiles(){
  const c=counts(state);
  const lw=lastWeek?counts(lastWeek):null;
  const d=(now,then)=>then==null?"":(now-then>=0?"+":"")+(now-then)+" WoW";
  const tiles=[
    {lbl:"New firms onboarding",val:ONBOARD.filter(f=>state.onboard[f.firm].status<4).length,delta:ONBOARD.reduce((n,f)=>n+f.depos.length,0)+" first depos booked · welcome before depo #1",cls:""},
    {lbl:"Firms on watchlist",val:FIRMS.length,delta:"7 Tier-1 · 10 high-cancel · 10 recently quiet · 14 single-thread",cls:""},
    {lbl:"Firms touched this week",val:c.touched,delta:lw?d(c.touched,counts(lastWeek).touched):"outreach sent or beyond",cls:lw&&c.touched>=counts(lastWeek).touched?"up":""},
    {lbl:"Walkthroughs booked",val:c.walk,delta:lw?d(c.walk,counts(lastWeek).walk):"the metric that predicts rebooking",cls:"up"},
    {lbl:"Depos rebooked",val:c.rebooked,delta:lw?d(c.rebooked,counts(lastWeek).rebooked):"the only number that counts",cls:"up"},
    {lbl:"Sept depos on the books",val:65,delta:"needs ~200+ by Labor Day",cls:"bad"}
  ];
  document.getElementById("tiles").innerHTML=tiles.map(t=>`<div class="tile"><div class="lbl">${t.lbl}</div><div class="val">${t.val}</div><div class="delta ${t.cls}">${t.delta}</div></div>`).join("");
}

// ---------- charts (inline SVG) ----------
const tip=document.getElementById("tip");
function showTip(e,html){tip.innerHTML=html;tip.style.display="block";tip.style.left=(e.clientX+12)+"px";tip.style.top=(e.clientY-10)+"px";}
function hideTip(){tip.style.display="none";}

function barChart(el,labels,vals,unit,color,highlightLast){
  const W=360,H=170,P={l:34,r:8,t:16,b:22};
  const rawMax=Math.max(...vals);
  const step=rawMax<=16?5:rawMax<=45?10:rawMax<=90?25:50;
  const max=Math.ceil(rawMax/step)*step;
  const iw=(W-P.l-P.r)/labels.length;
  const bw=Math.min(24,iw-6);
  let s=`<svg viewBox="0 0 ${W} ${H}" style="width:100%">`;
  for(let g=0;g<=max;g+=step){const y=H-P.b-(g/max)*(H-P.t-P.b);
    s+=`<line x1="${P.l}" x2="${W-P.r}" y1="${y}" y2="${y}" stroke="var(--grid)" stroke-width="1"/>`;
    s+=`<text x="${P.l-6}" y="${y+4}" font-size="10" fill="var(--muted)" text-anchor="end">${g}</text>`;}
  vals.forEach((v,i)=>{const h=(v/max)*(H-P.t-P.b);const x=P.l+i*iw+(iw-bw)/2;const y=H-P.b-h;
    s+=`<path d="M${x},${H-P.b} L${x},${y+4} Q${x},${y} ${x+4},${y} L${x+bw-4},${y} Q${x+bw},${y} ${x+bw},${y+4} L${x+bw},${H-P.b} Z" fill="${color}" data-i="${i}" class="bar"/>`;
    s+=`<text x="${P.l+i*iw+iw/2}" y="${H-6}" font-size="10" fill="var(--muted)" text-anchor="middle">${labels[i]}</text>`;});
  // direct-label the extreme + last
  const maxi=vals.indexOf(Math.max(...vals)),last=vals.length-1;
  [maxi,last].forEach(i=>{const h=(vals[i]/max)*(H-P.t-P.b);
    s+=`<text x="${P.l+i*iw+iw/2}" y="${H-P.b-h-5}" font-size="10.5" font-weight="600" fill="var(--ink)" text-anchor="middle">${vals[i]}</text>`;});
  s+=`<line x1="${P.l}" x2="${W-P.r}" y1="${H-P.b}" y2="${H-P.b}" stroke="var(--axis)" stroke-width="1"/></svg>`;
  el.innerHTML=s;
  el.querySelectorAll(".bar").forEach(b=>{b.addEventListener("mousemove",e=>showTip(e,`<b>${labels[+b.dataset.i]}</b>: ${vals[+b.dataset.i]}${unit}`));b.addEventListener("mouseleave",hideTip);});
}
function lineChart(el,labels,vals,unit){
  const W=360,H=170,P={l:34,r:22,t:18,b:22};
  const max=Math.ceil(Math.max(...vals)/10)*10;
  const X=i=>P.l+i*(W-P.l-P.r)/(labels.length-1), Y=v=>H-P.b-(v/max)*(H-P.t-P.b);
  let s=`<svg viewBox="0 0 ${W} ${H}" style="width:100%">`;
  for(let g=0;g<=max;g+=10){s+=`<line x1="${P.l}" x2="${W-P.r}" y1="${Y(g)}" y2="${Y(g)}" stroke="var(--grid)"/>`;s+=`<text x="${P.l-6}" y="${Y(g)+4}" font-size="10" fill="var(--muted)" text-anchor="end">${g}</text>`;}
  s+=`<path d="M${vals.map((v,i)=>`${X(i)},${Y(v)}`).join(" L")}" fill="none" stroke="var(--blue)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" d="M${vals.map((v,i)=>`${X(i)},${Y(v)}`).join(" L")}"/>`.replace('d="M','d="M');
  vals.forEach((v,i)=>{s+=`<circle cx="${X(i)}" cy="${Y(v)}" r="4.5" fill="var(--blue)" stroke="var(--surface)" stroke-width="2" data-i="${i}" class="pt"/>`;
    s+=`<text x="${X(i)}" y="${H-6}" font-size="10" fill="var(--muted)" text-anchor="middle">${labels[i]}</text>`;});
  const last=vals.length-1, maxi=vals.indexOf(Math.max(...vals));
  [maxi,last].forEach(i=>{const ly=Math.max(11,Y(vals[i])-9);const lx=Math.min(X(i),W-20);s+=`<text x="${lx}" y="${ly}" font-size="10.5" font-weight="600" fill="var(--ink)" text-anchor="middle">${vals[i]}%</text>`;});
  s+=`<line x1="${P.l}" x2="${W-P.r}" y1="${H-P.b}" y2="${H-P.b}" stroke="var(--axis)"/></svg>`;
  el.innerHTML=s;
  el.querySelectorAll(".pt").forEach(p=>{p.addEventListener("mousemove",e=>showTip(e,`<b>${labels[+p.dataset.i]}</b>: ${vals[+p.dataset.i]}${unit}`));p.addEventListener("mouseleave",hideTip);});
}
barChart(document.getElementById("chartVol"),MONTHS,VOL," depos/biz-day","var(--blue)");
lineChart(document.getElementById("chartCanc"),MONTHS,CANC,"% cancelled");
barChart(document.getElementById("chartFwd"),FWD.map(d=>d.m),FWD.map(d=>d.v)," booked","var(--blue)");
document.getElementById("tblVol").innerHTML="<table><tr><th>Month</th><th>Depos/biz-day</th></tr>"+MONTHS.map((m,i)=>`<tr><td>${m}</td><td>${VOL[i]}</td></tr>`).join("")+"</table>";
document.getElementById("tblCanc").innerHTML="<table><tr><th>Month</th><th>Cancel %</th></tr>"+MONTHS.map((m,i)=>`<tr><td>${m}</td><td>${CANC[i]}%</td></tr>`).join("")+"</table>";
document.getElementById("tblFwd").innerHTML="<table><tr><th>Month</th><th>Booked</th></tr>"+FWD.map(d=>`<tr><td>${d.m}</td><td>${d.v}</td></tr>`).join("")+"</table>";

// ---------- onboarding section ----------
function daysUntil(iso){const d=new Date(iso+"T12:00:00");const t=new Date();t.setHours(12,0,0,0);return Math.round((d-t)/86400000);}
function whenChip(iso){const n=daysUntil(iso);
  if(n<0)return`<span class="ob-when w-later">held ${-n}d ago</span>`;
  if(n===0)return`<span class="ob-when w-today">FIRST DEPO TODAY</span>`;
  if(n<=3)return`<span class="ob-when w-soon">first depo in ${n}d</span>`;
  return`<span class="ob-when w-later">first depo in ${n}d</span>`;}
function renderOnboard(){
  const open=ONBOARD.filter(f=>state.onboard[f.firm].status<4).length;
  document.getElementById("obCount").textContent=open+" of "+ONBOARD.length+" in flight";
  document.getElementById("obGrid").innerHTML=ONBOARD.map(f=>{
    const st=state.onboard[f.firm];
    const gaps=f.depos.filter(d=>!d.rep).length;
    return`<div class="ob-card">
      <h4><span class="ob-new">NEW FIRM</span> ${f.firm} ${whenChip(f.firstDepo)}</h4>
      <ul>
        ${f.depos.map(d=>`<li>• <b>${d.w}</b> — ${d.disp} (${d.min} min)${d.rep?"":' <span class="norep">⚠ no reporter assigned</span>'}</li>`).join("")}
        <li>Contact: ${f.contacts.map(c=>`<b>${c.name||c.first}</b> &lt;${c.email}&gt;`).join(" · ")}</li>
        ${gaps?`<li class="norep">⚠ ${gaps} depo${gaps>1?"s":""} still need${gaps>1?"":"s"} a digital reporter — flag ops today</li>`:""}
      </ul>
      <div class="ob-foot">
        <select class="status-sel st-${st.status===4?4:st.status===5?2:st.status===6?6:st.status}" onchange="setOb('${esc(f.firm)}','status',+this.value);renderOnboard();renderTiles();">${OSTATUSES.map((s,i)=>`<option value="${i}" ${i===st.status?"selected":""}>${s}</option>`).join("")}</select>
        ${repSel(st.owner,`setOb('${esc(f.firm)}','owner',this.value)`)}
        <button class="primary" onclick="openEmail('${esc(f.firm)}','onboard')">✉ Welcome email</button>
      </div>
      <textarea class="ob-notes" placeholder="Onboarding notes — tech check result, who joined the walkthrough…" onchange="setOb('${esc(f.firm)}','notes',this.value)">${st.notes}</textarea>
    </div>`;}).join("");
}
window.setOb=(name,k,v)=>{state.onboard[name][k]=v;};

// ---------- board ----------
let filter="all", q="";
const CHIPDEFS=[["all","All"],["dark","Tier 1 · Dark"],["cancel","High cancel"],["summer","Recently quiet"],["single","Single-threaded"],["open","Still untouched"]];
function renderChips(){document.getElementById("chips").innerHTML=CHIPDEFS.map(([k,l])=>`<button class="chip ${filter===k?"on":""}" data-k="${k}">${l}${k==="all"?" ("+FIRMS.length+")":""}</button>`).join("");
  document.querySelectorAll(".chip").forEach(c=>c.onclick=()=>{filter=c.dataset.k;renderChips();renderBoard();});}
document.getElementById("search").addEventListener("input",e=>{q=e.target.value.toLowerCase();renderBoard();});

function whyText(f){
  const bits=[];
  if(f.flags.includes("dark"))bits.push(`Dark ${f.daysSince} days — their normal rhythm was a depo every ${f.gap??"~14"} days. This silence started before summer; treat as at-risk.`);
  if(f.flags.includes("summer"))bits.push(`Quiet ${f.daysSince} days with nothing booked ahead. Last depo was June, so summer is the likely cause — but verify it on the call. If you hear a competitor's name or "we're rethinking vendors," treat as Tier 1 immediately.`);
  if(f.flags.includes("cancel"))bits.push(`${f.cancels} cancellations vs ${f.held} held (${f.cancelRate}%). Scheduling chaos, not disloyalty — help them reschedule frictionlessly.`);
  if(f.flags.includes("single"))bits.push(`${f.held} depos, all scheduled by one person. Get a second scheduler named and trained.`);
  return bits.join(" ");
}
function wowTag(name){
  if(!lastWeek||!lastWeek.firms[name])return"";
  const then=lastWeek.firms[name].status, now=state.firms[name].status;
  if(now>then)return`<span class="wow-tag">▲ moved from “${STATUSES[then]}” last week</span>`;
  return"";
}
function renderBoard(){
  const list=FIRMS.filter(f=>{
    if(q&&!f.firm.toLowerCase().includes(q))return false;
    if(filter==="all")return true;
    if(filter==="open")return state.firms[f.firm].status===0;
    return f.flags.includes(filter);
  }).sort((a,b)=>FLAGMETA[a.flags[0]].pri-FLAGMETA[b.flags[0]].pri||b.held-a.held);
  document.getElementById("board").innerHTML=list.map(f=>{
    const st=state.firms[f.firm];
    return `<div class="firm" data-f="${f.firm}">
    <div class="frow" onclick="if(event.target.closest('select,input,button,textarea'))return;this.parentElement.classList.toggle('open')">
      <span class="fname">${f.firm}</span>
      ${f.flags.map(fl=>`<span class="badge ${FLAGMETA[fl].cls}">${FLAGMETA[fl].lbl}</span>`).join("")}
      <span class="fstats"><span><b>${f.held}</b> held '26</span><span>last <b>${f.lastDepo}</b></span><span><b>${f.daysSince}d</b> quiet</span><span><b>${f.future}</b> booked ahead</span>${f.cancelRate!=null?`<span><b>${f.cancelRate}%</b> cancel</span>`:""}</span>
      <span class="fright">${wowTag(f.firm)}
        ${repSel(st.owner,`setF('${esc(f.firm)}','owner',this.value);renderBoard()`)}
        <select class="status-sel st-${st.status}" onchange="setStatus('${esc(f.firm)}',this.value)">${STATUSES.map((s,i)=>`<option value="${i}" ${i===st.status?"selected":""}>${s}</option>`).join("")}</select>
        <button class="primary" onclick="openEmail('${esc(f.firm)}')">✉ Generate email</button>
      </span>
    </div>
    <div class="fdetail">
      <div>
        <h5>Relationship</h5>
        <ul>
          <li>Contacts: ${f.contacts.map(c=>`<b>${c.name||c.first}</b> &lt;${c.email}&gt;`).join(" · ")||"—"}</li>
          <li>Recent depositions:</li>
          ${f.recent.map(r=>`<li>• <b>${r.name}</b> — ${r.date}</li>`).join("")}
          <li>~<b>${f.hours}h</b> of testimony on record with Skribe in 2026</li>
          ${f.nextBooked?`<li>Next on calendar: <b>${f.nextBooked}</b></li>`:`<li>Nothing on the calendar ahead</li>`}
        </ul>
        <div class="why">${whyText(f)}</div>
      </div>
      <div class="actgrid">
        <h5>This week's action</h5>
        <label>Account owner (rep)</label>${repSel(st.owner,`setF('${esc(f.firm)}','owner',this.value);renderBoard()`,true)}
        <label>Next step due</label><input type="date" value="${st.next}" onchange="setF('${esc(f.firm)}','next',this.value)">
      </div>
      <div class="actgrid">
        <h5>Notes / call log</h5>
        <textarea placeholder="What happened on the last touch? What did they say?" onchange="setF('${esc(f.firm)}','notes',this.value)">${st.notes}</textarea>
      </div>
    </div></div>`;
  }).join("")||"<div class='card'>No firms match.</div>";
}
function esc(s){return s.replace(/'/g,"\\'");}
window.setStatus=(name,v)=>{state.firms[name].status=+v;renderTiles();renderBoard();};
window.setF=(name,k,v)=>{state.firms[name][k]=v;};

// ---------- email generator ----------
const FEATURES=`Since you last used us, we've shipped a lot:
  •  AI deposition summaries — a page-one summary of every transcript, automatically
  •  Key-moment & inconsistency flags — the AI marks admissions and contradictions for you
  •  Instant search + video clips — find any phrase across every depo in a matter and clip the video in seconds
  •  Same-day rough drafts, certified transcripts in 5 business days, as always human-verified and court-admissible`;

function emailFor(f,angle,contact){
  const first=contact?contact.first:"there";
  const lastDepo=f.recent[0];
  const depoRef=lastDepo?`the ${lastDepo.name} deposition on ${lastDepo.date}`:"your recent depositions";
  const walkthrough=`Could I grab 15 minutes to walk you through it on one of your own transcripts? I'll pull up ${lastDepo?lastDepo.name:"a recent depo"} and show you the summary, the flagged moments, and how to clip testimony for a motion or mediation — no slides, just your record.`;
  let sub,body;
  if(angle==="dark"){
    sub=`Your fall depositions + what's new at Skribe since ${lastDepo?lastDepo.date.split(" ")[0]:"spring"}`;
    body=`Hi ${first},

It's been a little while since ${depoRef} — you've run ${f.held} depositions (~${f.hours} hours of testimony) with us this year, and I wanted to check in personally as fall dockets start to firm up.

${FEATURES}

Everything above already works on your existing ${f.held} transcripts — your prior testimony is searchable and clip-able today.

${walkthrough}

If depositions are coming up on your fall calendar, reply with the dates and we'll take the scheduling off your plate — reporter, video, and delivery handled end to end.

Best,
Matthew
Head of Customer Success, Skribe`;
  } else if(angle==="summer"){
    sub=`Fall docket planning — lock your September depo dates now`;
    body=`Hi ${first},

Hope you got some real time off this summer. As dockets pick back up, I wanted to reach out early — September calendars fill fast, and I'd love to get your fall depositions locked in while the good dates are still open.

Quick recap of what you have with us: ${f.held} depositions this year (most recently ${depoRef}), all searchable in your Skribe library right now.

${FEATURES}

${walkthrough}

Send over your fall deposition list — even tentative dates — and we'll hold reporters for all of them. One email, zero coordination headaches.

Best,
Matthew
Head of Customer Success, Skribe`;
  } else if(angle==="cancel"){
    sub=`Making rescheduling painless — and getting more out of the depos you've taken`;
    body=`Hi ${first},

I was reviewing your account and noticed how many of your depositions have had to move this year — ${f.cancels} rescheduled or cancelled against ${f.held} completed. That's the reality of witness and opposing-counsel calendars, and I want to make sure we're absorbing that chaos for you, not adding to it.

Two things I'd love to show you:

1. Frictionless rescheduling — when a witness falls through, one message to us moves everything: reporter, video, notice logistics. No cancellation penalty games.
2. Getting more from the depos you HAVE taken. ${FEATURES}

${walkthrough}

And if anything about how cancellations have been handled has been less than smooth, I want to hear it — that feedback goes straight to how we operate.

Best,
Matthew
Head of Customer Success, Skribe`;
  } else {
    sub=`A team walkthrough for ${f.firm} — so it's not all on ${first}`;
    body=`Hi ${first},

You've personally scheduled all ${f.held} of ${f.firm}'s depositions with us this year — most recently ${depoRef}. Honestly, you're one of our power users, and I want to make sure your whole team gets the same leverage you've built.

${FEATURES}

I'd love to set up a 30-minute team walkthrough — you bring whoever else touches depositions (paralegals, associates), and I'll get everyone set up to schedule, search, and clip on their own accounts. Your matters stay organized in one firm workspace, and nothing bottlenecks when you're in trial or out of office.

${walkthrough.replace("Could I grab 15 minutes","If a team session is overkill, I can also do 15 minutes just with you")}

When works in the next couple of weeks?

Best,
Matthew
Head of Customer Success, Skribe`;
  }
  return{sub,body};
}

function onboardEmail(f,angle,contact){
  const first=contact?contact.first:"there";
  const d0=f.depos[0];
  const multi=f.depos.length>1;
  const schedule=f.depos.map(d=>`  •  ${d.w} — ${d.disp}`).join("\n");
  if(angle==="followup"){
    const upcoming=f.depos.filter(d=>daysUntil(d.date)>0);
    return{sub:`Your ${d0.w} transcript — and how to get the most out of it`,
body:`Hi ${first},

Congratulations on wrapping your first deposition with Skribe — the ${d0.w} testimony is captured and your rough transcript is already in your account. The certified, human-verified transcript will be delivered within 5 business days.

While it's fresh, three things worth doing in the next ten minutes:
  •  Open the AI summary — a page-one read of the entire testimony, already waiting for you
  •  Check the key-moment flags — admissions and inconsistencies the AI marked for review
  •  Try clipping — highlight any exchange and turn it into a video clip for a motion, mediation, or demand package

If you'd like, I'll do a quick 15-minute session on your own transcript and show you how attorneys use these to cut review time to almost nothing — usually the moment it clicks.

${upcoming.length?`I also see ${upcoming.map(d=>`${d.w} on ${d.disp.split(",")[0]}`).join(" and ")} coming up — we have it handled, and everything will land in the same workspace, organized by matter.`:`When your next deposition gets noticed, just reply with the date — one email and we take care of reporter, video, and delivery end to end.`}

How did the first one go? Anything that wasn't smooth, I want to hear it directly.

Best,
Matthew
Head of Customer Success, Skribe`};}
  if(angle==="techcheck"){
    return{sub:`Quick tech check before the ${d0.w} deposition ${daysUntil(d0.date)===0?"today":"on "+d0.disp.split(",")[0]}`,
body:`Hi ${first},

Ahead of the ${d0.w} deposition (${d0.disp}), I'd like to run a 10-minute tech check with whoever will be in the room — camera, audio, exhibits, and the join link — so day-of is completely smooth.

What to expect on deposition day:
  •  Your Skribe digital reporter handles the record — video + audio, captured securely
  •  A rough transcript lands the same day
  •  Certified, human-verified transcript in 5 business days — court-admissible
  •  Live support the whole way if anything comes up

When today or tomorrow works for a quick check? Reply with a time and a phone number for backup.

Best,
Matthew
Head of Customer Success, Skribe`};}
  return{sub:`Welcome to Skribe — everything set for ${d0.w}${multi?" and your other depositions":""}`,
body:`Hi ${first},

Welcome to Skribe! I lead Customer Success here, and I wanted to reach out personally before your first deposition with us${multi?` — I see you have ${f.depos.length} on the calendar`:""}:

${schedule}

Here's how it works, start to finish:
  •  Before: we handle the coordination — reporter, video, logistics. Nothing for you to chase.
  •  During: your digital reporter captures secure video + audio of the full testimony.
  •  Same day: a rough transcript is in your account within hours.
  •  5 business days: your certified, human-verified, court-admissible transcript is delivered.
  •  After: AI summaries, key-moment flags, instant search, and video clips — your testimony becomes something you can actually work with, not a PDF you scroll.

I'd love to give you a 15-minute walkthrough before ${d0.disp.split(",")[0]} so your team knows exactly where everything lands and how to pull clips and summaries the moment the rough hits. What time works?

And a direct line: if anything at all comes up before or during the deposition, reply here or call us — a human answers.

Welcome aboard,
Matthew
Head of Customer Success, Skribe`};}

let modalFirm=null, modalType="watch";
window.openEmail=(name,type)=>{
  modalType=type==="onboard"?"onboard":"watch";
  const f=(modalType==="onboard"?ONBOARD:FIRMS).find(x=>x.firm===name);modalFirm=f;
  document.getElementById("mTitle").textContent=(modalType==="onboard"?"Onboarding — ":"Outreach — ")+f.firm;
  document.getElementById("mSub").textContent=modalType==="onboard"
    ?`New firm — first depo ${f.depos[0].disp}. Welcome them before it, tech-check the day before. Edit before sending.`
    :`Auto-drafted from their history: ${f.held} depos held, last on ${f.lastDepo}, ${f.future} booked ahead. Edit before sending — make it yours.`;
  const toSel=document.getElementById("mTo");
  toSel.innerHTML=f.contacts.map((c,i)=>`<option value="${i}">${c.name||c.first} — ${c.email}</option>`).join("")||"<option value=''>no contact on file — check CRM</option>";
  const aSel=document.getElementById("mAngle");
  if(modalType==="onboard"){
    const held=daysUntil(f.depos[0].date)<0||state.onboard[f.firm].status>=4;
    aSel.innerHTML=`<option value="welcome">Welcome + first-depo walkthrough</option><option value="techcheck">Day-before tech check</option><option value="followup" ${held?"selected":""}>After first depo — follow-up</option>`;
  } else {
    const angles={dark:"Win-back (gone dark)",summer:"Fall-docket check-in",cancel:"Reschedule help + feature value",single:"Team walkthrough (de-risk single thread)"};
    aSel.innerHTML=f.flags.map(fl=>`<option value="${fl}">${angles[fl]}</option>`).join("");
  }
  const regen=()=>{const c=f.contacts[+toSel.value]||null;
    const {sub,body}=modalType==="onboard"?onboardEmail(f,aSel.value,c):emailFor(f,aSel.value,c);
    document.getElementById("mSubject").value=sub;document.getElementById("mBody").value=body;};
  toSel.onchange=regen;aSel.onchange=regen;regen();
  document.getElementById("modalBg").style.display="flex";
};
function currentEmail(){return{to:(modalFirm.contacts[+document.getElementById("mTo").value]||{}).email||"",sub:document.getElementById("mSubject").value,body:document.getElementById("mBody").value};}
async function copyEmail(){const e=currentEmail();await navigator.clipboard.writeText(`To: ${e.to}\nSubject: ${e.sub}\n\n${e.body}`);const c=document.getElementById("mCopied");c.style.display="inline";setTimeout(()=>c.style.display="none",1600);}
document.getElementById("mCopy").onclick=copyEmail;
document.getElementById("mMail").onclick=()=>{const e=currentEmail();location.href=`mailto:${encodeURIComponent(e.to)}?subject=${encodeURIComponent(e.sub)}&body=${encodeURIComponent(e.body)}`;};
document.getElementById("mMarkSent").onclick=async()=>{await copyEmail();
  if(modalType==="onboard"){if(state.onboard[modalFirm.firm].status<1){state.onboard[modalFirm.firm].status=1;renderTiles();renderOnboard();}}
  else if(state.firms[modalFirm.firm].status<1){state.firms[modalFirm.firm].status=1;renderTiles();renderBoard();}};
document.getElementById("mClose").onclick=()=>document.getElementById("modalBg").style.display="none";
document.getElementById("modalBg").addEventListener("click",e=>{if(e.target.id==="modalBg")e.target.style.display="none";});

// ---------- export / import (WoW) ----------
document.getElementById("exportBtn").onclick=()=>{
  const blob=new Blob([JSON.stringify(state,null,1)],{type:"application/json"});
  const a=document.createElement("a");a.href=URL.createObjectURL(blob);
  a.download=`skribe_cs_board_${state.week}.json`;a.click();
};
document.getElementById("importBtn").onclick=()=>document.getElementById("importFile").click();
document.getElementById("importFile").addEventListener("change",e=>{
  const file=e.target.files[0];if(!file)return;
  const rd=new FileReader();
  rd.onload=()=>{try{
    const data=JSON.parse(rd.result);
    lastWeek=data;
    // carry forward owners/notes/status from last week as the starting point
    Object.keys(state.firms).forEach(k=>{if(data.firms&&data.firms[k])state.firms[k]={...data.firms[k]};});
    Object.keys(state.onboard).forEach(k=>{if(data.onboard&&data.onboard[k])state.onboard[k]={...data.onboard[k]};});
    renderTiles();renderBoard();renderOnboard();
    alert("Imported snapshot from "+(data.week||"last week")+". Statuses carried forward — WoW deltas now shown on tiles and firm rows.");
  }catch(err){alert("Couldn't read that file — expected a board snapshot JSON.");}};
  rd.readAsText(file);
});

renderTiles();renderChips();renderBoard();renderOnboard();
</script>
</body>
</html>
